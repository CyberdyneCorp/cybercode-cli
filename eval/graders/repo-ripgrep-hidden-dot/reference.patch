+        wfile(td.path().join(".hidden."), "");
+        wfile(td.path().join(".hidden.."), "");
+        wfile(td.path().join("..."), "");
+        mkdirp(td.path().join(".dir."));
+        wfile(td.path().join(".dir./inner"), "");
+
+        assert_paths(td.path(), &WalkBuilder::new(td.path()), &["visible."]);
