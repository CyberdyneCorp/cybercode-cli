        "bypass": "deny"
      },
      "line": "! Possible prompt injection in webfetch result (exfil_url). Risky actions in this run will be denied (bypass)."
    },
    {
      "name": "taint off states no consequence",
      "record": {
        "source": "browser",
        "origin": "https://x.example/a",
        "detector_version": 2,
        "signals": [
          {
            "kind": "role_markup",
            "excerpt": "x"
