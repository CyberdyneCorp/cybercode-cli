    def fib(n):                                                                       Context
        # Build up solution iteratively                                               100 tokens · window unknown
        dp = [0, 1]                                                                   — spent
        for i in range(2, n + 1):
            dp.append(dp[i - 1] + dp[i - 2])                                          ▼ MCP
        return dp[n]                                                                  No MCP servers
